# ==========================================
# Nexus Creative Studio - Universal Environment Configuration
# Compatible with Vercel, Railway, Render, Netlify, Docker
# ==========================================

# ==========================================
# RUNTIME CONFIGURATION (Required for all platforms)
# ==========================================

# Environment
NODE_ENV=production

# ==========================================
# DATABASE CONFIGURATION (Required)
# ==========================================

# Supabase Configuration (Primary Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Alternative: Direct Database URL (if not using Supabase)
# DATABASE_URL=postgresql://user:password@host:port/database

# ==========================================
# SECURITY (Required for Production)
# ==========================================

# Session Security (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_session_secret_here_32_characters_minimum

# CORS Origins (comma-separated for multiple domains)
CORS_ORIGIN=https://your-domain.com,https://your-alt-domain.com

# ==========================================
# RATE LIMITING (Optional - has defaults)
# ==========================================

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# CLIENT CONFIGURATION (Browser-Exposed Variables)
# ==========================================

# Vite client environment variables (must start with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_ENVIRONMENT=production
VITE_API_URL=/api

# ==========================================
# PLATFORM-SPECIFIC CONFIGURATIONS
# ==========================================

# Vercel (Auto-detected, no additional config needed)
# VERCEL=true (auto-set by Vercel)

# Railway (Auto-detected, no additional config needed)
# RAILWAY_ENVIRONMENT=production (auto-set by Railway)

# Render (Auto-detected, no additional config needed)
# RENDER=true (auto-set by Render)

# Netlify (Auto-detected, no additional config needed)
# NETLIFY=true (auto-set by Netlify)

# Docker (Set if running in Docker)
# DOCKER_CONTAINER=true

# ==========================================
# OPTIONAL INTEGRATIONS
# ==========================================

# Email Services
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@yourapp.com

# Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Error Monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io

# ==========================================
# DEVELOPMENT OVERRIDES (Local only)
# ==========================================

# Uncomment for local development
# NODE_ENV=development
# PORT=5000
# CORS_ORIGIN=http://localhost:5173

# ==========================================
# DEPLOYMENT VERIFICATION
# ==========================================

# Health check endpoint: /health
# API endpoints: /api/*
# Static files: /*

# ==========================================
# QUICK SETUP COMMANDS
# ==========================================

# 1. Copy this file to .env
# 2. Replace all "your_*_here" values with actual credentials
# 3. Deploy using platform-specific commands:
#    - Vercel: vercel --prod
#    - Railway: railway up
#    - Render: git push (auto-deploy)
#    - Netlify: netlify deploy --prod
#    - Docker: docker build -t app . && docker run -p 3000:3000 app