{
  "name": "nexus-creative-studio",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Full-stack creative agency platform with AI-powered solutions",
  "keywords": [
    "creative-agency",
    "fullstack",
    "react",
    "typescript",
    "vite",
    "express"
  ],
  "author": "Jobayer Hoque Siddique <jobayerhoquesiddique@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexxusstudio/Nexus-Creative-Studio"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx --watch server/index.ts",
    "build": "npm run clean && npm run type-check && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=api/index.js --sourcemap",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "start": "node api/index.js",
    "start:dev": "npm run build && npm start",
    
    "deploy": "npm run build",
    "deploy:vercel": "npm run build && vercel --prod",
    "deploy:vercel:preview": "npm run build && vercel",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=public --functions=api",
    "deploy:netlify:preview": "npm run build && netlify deploy --dir=public --functions=api",
    "deploy:railway": "npm run build",
    "deploy:render": "npm run build",
    "deploy:docker": "docker build -t nexus-creative-studio . && docker run -p 3000:3000 nexus-creative-studio",
    
    "verify:deployment": "./scripts/verify-deployment.sh",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/db/seed.ts",
    "clean": "rm -rf dist public node_modules/.vite api/index.js* .vercel .netlify",
    "prepare": "husky install",
    "postbuild": "echo '✅ Build completed successfully! Ready for deployment.'",
    "docker:build": "docker build -t nexus-creative-studio .",
    "docker:run": "docker run -p 3000:3000 nexus-creative-studio",
    "docker:compose": "docker-compose up -d"
  },
  "dependencies": {
